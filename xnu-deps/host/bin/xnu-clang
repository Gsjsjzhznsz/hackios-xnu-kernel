#!/bin/bash
# clang wrapper for cross-building XNU on Linux:
#  - forces an Apple Mach-O target (stock Linux clang defaults to ELF)
#  - drops flags only Apple's clang understands
#  - links with the cctools ld64
HB="$(cd "$(dirname "$0")" && pwd)"
case "$(basename "$0")" in *++) drv=clang++; extra=(-fno-use-cxa-atexit);; *) drv=clang; extra=();; esac
# The kernel's compiler must not float with the build machine. XNU_HOST_CLANG pins it:
# R28i's CI points it at theos's toolchain clang (the tarball the workflow fetches by its
# git tag), because /usr/bin/clang is whatever apt ships that month -- one generation of
# it dropped the three "T2 VERDICT:" strings out of the kernel in silence (the gate
# caught it, run 40214391444), and the drift from one apt clang to the next is also the
# prime suspect behind R28g's userland-wide SIGBUS. Local builds that set nothing keep
# the old /usr/bin behavior.
CC_BIN="${XNU_HOST_CLANG:-/usr/bin/$drv}"
if [ -n "${XNU_HOST_CLANG:-}" ] && [ "$drv" = clang++ ]; then
  CC_BIN="${CC_BIN%clang}clang++"
fi
args=()
for a in "$@"; do
  case "$a" in
    -enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang) ;;
    -fapple-kext-vtable-verify|-Wno-vla-cxx-extension) ;;
    -Werror|-Werror=*|-Weverything|-pedantic-errors) ;;
    *) args+=("$a");;
  esac
done
# XNU_WRAPPER_LOG: one line per invocation = the real CWD, a TAB, then the full argv --
# the CI's R28i diagnostics replay the raphael_adreno line from the exact directory make
# ran it in (the relative -I paths of the kernel build only resolve there).
# %q keeps every argument one argument even when the kernel's own defines carry spaces
# (e.g. -DCONFIG_NMBCLUSTERS=((1024 * 256) / MCLBYTES)); shlex splits them back.
if [ -n "${XNU_WRAPPER_LOG:-}" ]; then
  qargs=(); for a in "${args[@]}"; do qargs+=("$(printf '%q' "$a")"); done
  printf '%s\t%s\n' "$PWD" "${qargs[*]}" >> "$XNU_WRAPPER_LOG" 2>/dev/null || true
fi
# XNU_CCACHE=1 (with ccache on the PATH): compile through ccache. The wrapper always adds the
# same flags for the same tree, so a rebuild of an unchanged kernel is nearly all cache hits;
# ccache runs the compiler itself when it is not compiling, so the link passes through too.
# Nothing changes unless the variable is set: local builds stay exactly as they were.
if [ -n "${XNU_CCACHE:-}" ] && command -v ccache >/dev/null 2>&1; then
  exec ccache "$CC_BIN" -include "$HB/../../hostinc/xnu_clang_compat.h" -target arm64-apple-ios${XNU_SDK_VERSION:-16.5} --ld-path="$HB/ld64" \
    -w "${extra[@]}" "${args[@]}"
fi
exec "$CC_BIN" -include "$HB/../../hostinc/xnu_clang_compat.h" -target arm64-apple-ios${XNU_SDK_VERSION:-16.5} --ld-path="$HB/ld64" \
  -w "${extra[@]}" "${args[@]}"
