#!/bin/bash
# clang wrapper for cross-building XNU on Linux:
#  - forces an Apple Mach-O target (stock Linux clang defaults to ELF)
#  - drops flags only Apple's clang understands
#  - links with the cctools ld64
HB="$(cd "$(dirname "$0")" && pwd)"
case "$(basename "$0")" in *++) drv=clang++; extra=(-fno-use-cxa-atexit);; *) drv=clang; extra=();; esac
args=()
for a in "$@"; do
  case "$a" in
    -enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang) ;;
    -fapple-kext-vtable-verify|-Wno-vla-cxx-extension) ;;
    -Werror|-Werror=*|-Weverything|-pedantic-errors) ;;
    *) args+=("$a");;
  esac
done
# XNU_CCACHE=1 (with ccache on the PATH): compile through ccache. The wrapper always adds the
# same flags for the same tree, so a rebuild of an unchanged kernel is nearly all cache hits;
# ccache runs the compiler itself when it is not compiling, so the link passes through too.
# Nothing changes unless the variable is set: local builds stay exactly as they were.
if [ -n "${XNU_CCACHE:-}" ] && command -v ccache >/dev/null 2>&1; then
  exec ccache /usr/bin/$drv -include "$HB/../../hostinc/xnu_clang_compat.h" -target arm64-apple-ios${XNU_SDK_VERSION:-16.5} --ld-path="$HB/ld64" \
    -w "${extra[@]}" "${args[@]}"
fi
exec /usr/bin/$drv -include "$HB/../../hostinc/xnu_clang_compat.h" -target arm64-apple-ios${XNU_SDK_VERSION:-16.5} --ld-path="$HB/ld64" \
  -w "${extra[@]}" "${args[@]}"
